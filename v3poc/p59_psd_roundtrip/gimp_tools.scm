; P59 GIMP 2.10 の script-fu（gimp -i -b で動かす）。run.py が load して呼ぶ。
; (dump in out-txt out-png out-psd)  … 開いて層の一覧を書き、合成を PNG に、手を加えずに PSD に保存する
; (edit in out-txt out-psd plan-...) … 人の直しを真似て PSD に保存する。どの操作が通ったかを out-txt に書く
(define (kind-of l)
  (cond ((= (car (gimp-item-is-group l)) 1) "group")
        ((= (car (gimp-item-is-text-layer l)) 1) "text")
        (else "layer")))
(define (mode-name m)
  (cond ((= m LAYER-MODE-NORMAL) "NORMAL") ((= m LAYER-MODE-MULTIPLY) "MULTIPLY") ((= m LAYER-MODE-PASS-THROUGH) "PASS-THROUGH")
        ((= m LAYER-MODE-NORMAL-LEGACY) "NORMAL-LEGACY") ((= m LAYER-MODE-MULTIPLY-LEGACY) "MULTIPLY-LEGACY") (else m)))
(define (dump-item l depth port)
  (let* ((name (car (gimp-item-get-name l)))
         (kind (kind-of l))
         (off (gimp-drawable-offsets l)))
    (write (list depth name kind (car (gimp-item-get-visible l)) (car (gimp-layer-get-opacity l)) (mode-name (car (gimp-layer-get-mode l)))
                 (car off) (cadr off) (car (gimp-drawable-width l)) (car (gimp-drawable-height l))
                 (car (gimp-item-get-parasite-list l))) port)
    (newline port)
    (if (equal? kind "text")
        (begin (write (list "text-content" (car (gimp-text-layer-get-text l)) "font" (car (gimp-text-layer-get-font l))) port) (newline port)))
    (if (equal? kind "group")
        (let* ((ch (gimp-item-get-children l)) (n (car ch)) (v (cadr ch)) (i 0))
          (while (< i n) (dump-item (vector-ref v i) (+ depth 1) port) (set! i (+ i 1)))))))
(define (dump-image image port)
  (let* ((ls (gimp-image-get-layers image)) (n (car ls)) (v (cadr ls)) (i 0))
    (write (list "image" (car (gimp-image-width image)) (car (gimp-image-height image)) "top-level" n
                 "parasites" (car (gimp-image-get-parasite-list image))) port) (newline port)
    (while (< i n) (dump-item (vector-ref v i) 0 port) (set! i (+ i 1)))))
(define (save-psd image out-psd)
  (file-psd-save RUN-NONINTERACTIVE image (vector-ref (cadr (gimp-image-get-layers image)) 0) out-psd out-psd 1 0))
(define (dump in out-txt out-png out-psd)
  (let* ((image (car (gimp-file-load RUN-NONINTERACTIVE in in)))
         (port (open-output-file out-txt)))
    (dump-image image port)
    (close-output-port port)
    (save-psd image out-psd)
    (let* ((dup (car (gimp-image-duplicate image)))
           (flat (car (gimp-image-merge-visible-layers dup CLIP-TO-IMAGE))))
      (file-png-save RUN-NONINTERACTIVE dup flat out-png out-png 0 9 0 0 0 0 0)
      (gimp-image-delete dup))
    (gimp-image-delete image)))

; 1つの操作を試し、通ったかどうかを書く。失敗しても次へ進む（失敗をそのまま記録するため）
(define (try port label thunk)
  (let ((r (catch 'failed (begin (thunk) 'ok))))
    (write (list "op" label (if (eq? r 'ok) "ok" "failed")) port) (newline port)))
(define (by-name image name) (car (gimp-image-get-layer-by-name image name)))
(define (edit in out-txt out-psd out-png line-name rename-from rename-to toggle-name group-name delete-name text-name text-group-name)
  (let* ((image (car (gimp-file-load RUN-NONINTERACTIVE in in)))
         (port (open-output-file out-txt)))
    ; 1. 線画の一部を塗る（ページの座標で範囲を選び、黒で塗る）
    (try port "paint_line_art" (lambda ()
      (gimp-image-select-rectangle image CHANNEL-OP-REPLACE 700 700 160 120)
      (gimp-context-set-foreground '(30 30 30))
      (gimp-drawable-edit-fill (by-name image line-name) FILL-FOREGROUND)
      (gimp-selection-none image)))
    ; 2. 層の名前を変える（目印ごと消える名前に変える）
    (try port "rename" (lambda () (gimp-item-set-name (by-name image rename-from) rename-to)))
    ; 3. 見せる・隠すを逆にする
    (try port "toggle_visible" (lambda ()
      (let ((l (by-name image toggle-name))) (gimp-item-set-visible l (- 1 (car (gimp-item-get-visible l)))))))
    ; 4. コマのグループの中に新しい層を足して描く（手の描き直しを真似る）
    (try port "add_layer_in_group" (lambda ()
      (let* ((g (by-name image group-name))
             (nl (car (gimp-layer-new image 1240 1754 RGBA-IMAGE "手の描き直し" 100 LAYER-MODE-NORMAL))))
        (gimp-image-insert-layer image nl g 0)
        (gimp-image-select-ellipse image CHANNEL-OP-REPLACE 900 820 90 70)
        (gimp-context-set-foreground '(0 0 0))
        (gimp-drawable-edit-fill nl FILL-FOREGROUND)
        (gimp-selection-none image))))
    ; 5. 層を消す
    (try port "delete_layer" (lambda () (gimp-image-remove-layer image (by-name image delete-name))))
    ; 6a. 写植の層の文字を変える（文字の層として読めていれば通る）
    (try port "set_text_of_imported_text_layer" (lambda () (gimp-text-layer-set-text (by-name image text-name) "直した台詞")))
    ; 6b. GIMP の文字の道具で、写植のグループに新しい文字の層を足す（人が打ち直すのを真似る）
    (try port "add_gimp_text_layer" (lambda ()
      (let* ((g (by-name image text-group-name))
             (tl (car (gimp-text-layer-new image "打ち直した台詞" "IPAGothic" 36 0))))
        (gimp-image-insert-layer image tl g 0)
        (gimp-text-layer-set-base-direction tl TEXT-DIRECTION-TTB-RTL)
        (gimp-layer-set-offsets tl 200 200))))
    (dump-image image port)
    (close-output-port port)
    (save-psd image out-psd)
    (let* ((dup (car (gimp-image-duplicate image)))
           (flat (car (gimp-image-merge-visible-layers dup CLIP-TO-IMAGE))))
      (file-png-save RUN-NONINTERACTIVE dup flat out-png out-png 0 9 0 0 0 0 0)
      (gimp-image-delete dup))
    (gimp-image-delete image)))
