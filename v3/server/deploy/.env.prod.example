# 本番の値（compose.prod.yaml）。cp deploy/.env.prod.example .env.prod して全部入れる。
# 既定値は無い。空や欠けがあれば docker compose が止まる。パスワードと鍵は長い乱数にする（例: openssl rand -hex 32）。

# アプリのイメージのタグ（docker compose build で作る名前 v3-app:<タグ>）
V3_APP_IMAGE_TAG=
# 利用者が開く住所（https://<名前>[:<口>]）。Keycloak の発行元と、ログインから戻る先になる
V3_PUBLIC_URL=
# Caddy のサイトの名前（例: manga.example.com）。公開の名前なら証明書を ACME で取る
V3_SITE_ADDRESS=
# 公開の名前なら ACME の連絡先のメール。手元の試験では internal（Caddy の内部の CA。ブラウザは信頼しない）
V3_TLS=
# Caddy の 443 をどこに出すか（例: 0.0.0.0:443）
V3_HTTPS_BIND=
# Keycloak の管理画面を出す 127.0.0.1 の口（SSH の転送で使う。外には出さない）
V3_KEYCLOAK_ADMIN_PORT=
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# PostgreSQL（正本 v3・openfga・keycloak・temporal・temporal_visibility を1つのサーバーに置く）
POSTGRES_USER=
POSTGRES_PASSWORD=

# ログイン（Keycloak の realm v3 の client v3-server。deploy/keycloak/realm-v3.json）
V3_OIDC_CLIENT_SECRET=
# セッションのクッキーに署名する鍵と、ログインしてから切れるまでの秒数
V3_SESSION_SECRET=
V3_SESSION_MAX_AGE_SECONDS=
V3_LOCK_TTL_SECONDS=
# OpenFGA の事前共有鍵（OpenFGA とアプリの両方に渡す。任意の長い文字列）
OPENFGA_PRESHARED_KEY=
# 1回の要求の本体の上限（バイト）。絵・PSD のアップロードも含む
V3_REQUEST_MAX_BYTES=
# 外から入る絵の画素数の上限（幅×高さ）。Pillow の Image.MAX_IMAGE_PIXELS（89478485）以下
V3_IMAGE_MAX_PIXELS=
# 戻す PSD の層の数の上限（グループも数える）
V3_PSD_MAX_LAYERS=

# 絵の置き場（SeaweedFS の S3）
V3_S3_BUCKET=
V3_S3_REGION=
V3_S3_ACCESS_KEY_ID=
V3_S3_SECRET_ACCESS_KEY=
# SeaweedFS の1つの volume の大きさ（MB）と volume の数の上限。掛けた値が絵の置き場の上限になる（例: 1024 と 100）
V3_SEAWEEDFS_VOLUME_SIZE_MB=
V3_SEAWEEDFS_VOLUME_MAX=

# 書き出しの文字に使う書体（.ttf・.otf・.ttc）を置いたホストのフォルダ
V3_FONT_HOST_DIR=
# 控え（deploy/backup.sh）を置くホストのフォルダ
V3_BACKUP_HOST_DIR=
# Temporal が終わった依頼の記録を残す期間（例: 72h）
V3_TEMPORAL_RETENTION=

LITELLM_MASTER_KEY=
