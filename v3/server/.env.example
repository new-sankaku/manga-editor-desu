# cp .env.example .env して値を入れる
LITELLM_MASTER_KEY=sk-ここに任意の長い文字列

# v3server が読む値（src/v3server/server_settings.py）。既定値は無い。足りなければ起動時に止まる
V3_DATABASE_URL=postgresql+psycopg://v3:v3@localhost:55432/v3
V3_TEMPORAL_ADDRESS=localhost:57233
V3_OPENFGA_URL=http://localhost:58080
V3_LITELLM_URL=http://localhost:54000
# ログインの方式。oidc（Keycloak。本番）か dev_header（開発と試験だけ。X-V3-User の値をそのまま利用者にする）
# dev_header の間は、起動時の警告・全部の応答の見出し X-V3-Auth-Mode・GET /health に出る
V3_AUTH_MODE=dev_header
# oidc のときに要る値（compose.prod.yaml と .env.prod.example を参照）
# V3_OIDC_ISSUER= V3_OIDC_DISCOVERY_URL= V3_OIDC_CLIENT_ID= V3_OIDC_CLIENT_SECRET=
# V3_PUBLIC_URL= V3_SESSION_SECRET= V3_SESSION_MAX_AGE_SECONDS=
# ロックの期限（秒）
V3_LOCK_TTL_SECONDS=900
# 絵の置き場。local（サーバーの手元のフォルダ。開発用）か s3（S3互換。本番は SeaweedFS）
V3_IMAGE_STORE=local
# local のときの絵のフォルダ。空のままだと起動しない（絵を扱わない試験は、試験の中でフォルダを渡す）
V3_IMAGE_DIR=
# s3 のときに要る値
# V3_S3_ENDPOINT_URL= V3_S3_BUCKET= V3_S3_REGION= V3_S3_ACCESS_KEY_ID= V3_S3_SECRET_ACCESS_KEY=
# 書体のファイル（.ttf・.otf・.ttc）を置くフォルダ。書き出しで文字を絵にするときに使う。無ければ文字のある書き出しは止まる
V3_FONT_DIR=
# PSD を書く Node と、書き出しの script（v3/psd_writer/write_layered_psd.js）
V3_NODE_EXECUTABLE=node
V3_PSD_WRITER_SCRIPT=../psd_writer/write_layered_psd.js
# 書き出しの文字を絵にする script（@napi-rs/canvas）
V3_TEXT_RENDER_SCRIPT=../psd_writer/render_text.js
# 書き出したファイル（PNG・PDF・PSD）を置くフォルダ。無ければ書き出しは止まる
V3_EXPORT_DIR=
