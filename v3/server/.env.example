# cp .env.example .env して値を入れる
LITELLM_MASTER_KEY=sk-ここに任意の長い文字列
# OpenFGA の事前共有鍵。compose の openfga がこの鍵の無い要求を断り、v3server が同じ値を送る
OPENFGA_PRESHARED_KEY=ここに任意の長い文字列

# v3server が読む値（src/v3server/server_settings.py）
V3_DATABASE_URL=postgresql+psycopg://v3:v3@localhost:55432/v3
V3_TEMPORAL_ADDRESS=localhost:57233
V3_OPENFGA_URL=http://localhost:58080
V3_LITELLM_URL=http://localhost:54000
# ログインはまだ無い。開発の間だけ、X-V3-User の値をそのまま利用者として受け取る。
# 1 以外では受け取らず、すべて401を返す。
V3_DEV_AUTH=1
# 絵のファイルを置くフォルダ。絵を扱う口（絵の登録・ペン・書き出し・PSD の取り込み）は、これが無ければ止まる
V3_IMAGE_DIR=
# 書体のファイル（.ttf・.otf・.ttc）を置くフォルダ。書き出しで文字を絵にするときに使う。無ければ文字のある書き出しは止まる
V3_FONT_DIR=
# PSD を書く Node と、書き出しの script（v3/psd_writer/write_layered_psd.js）
V3_NODE_EXECUTABLE=node
V3_PSD_WRITER_SCRIPT=../psd_writer/write_layered_psd.js
# 書き出しの文字を絵にする script（@napi-rs/canvas）
V3_TEXT_RENDER_SCRIPT=../psd_writer/render_text.js
# 書き出したファイル（PNG・PDF・PSD）を置くフォルダ。無ければ書き出しは止まる
V3_EXPORT_DIR=
# 上限（既定値は無い。無ければ起動時に止まる）
# 1回の要求の本体の上限（バイト）。絵・PSD のアップロードも含む。超えたら 413
V3_REQUEST_MAX_BYTES=268435456
# 外から入る絵（アップロード・生成した絵・PSD の層）の画素数の上限（幅×高さ）。
# Pillow の Image.MAX_IMAGE_PIXELS（89478485）より大きくすると断る。B4 600dpi（約5,200万画素）までは入る
V3_IMAGE_MAX_PIXELS=89478485
# 戻す PSD の層の数の上限（グループも数える）
V3_PSD_MAX_LAYERS=1000
